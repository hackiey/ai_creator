{
  "expo": {
    "name": "AI Creator",
    "slug": "ai-creator",
    "version": "0.2.2",
    "icon": "./assets/icon.png",
    "scheme": "ai-creator",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.anonymous.aicreator",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
